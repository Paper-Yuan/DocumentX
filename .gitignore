# Generated TLS material for the local HTTPS portal (machine-specific private key)
apps/desktop/desktop_hub/tls/
apps/desktop/desktop_hub/temp_transfers/

# Android release signing material — must never be committed
apps/android/com/keystore.properties
*.jks
*.keystore

# Installer build intermediates
apps/desktop/installer/build_staging/
apps/desktop/installer/payload.zip
apps/desktop/installer/SafeDrop.exe
apps/desktop/installer/uninstall.exe

# OS and Editor specific
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
.vscode/
*.swp
*~

# Agent workspace state
.zcode/

# Mimosa security-plugin runtime state: per-session baselines, finding ledgers and
# reports. Transient and session-scoped, so it must not be versioned. The plugin's
# local policy file .mimosa/config.json is intentionally kept out of git too, so the
# repo's gate behaviour stays at the plugin default rather than carrying one machine's
# relaxation into every clone.
.mimosa/

# Local hub settings: the vault directory is machine-specific and must never be committed.
apps/desktop/desktop_hub/config.json
