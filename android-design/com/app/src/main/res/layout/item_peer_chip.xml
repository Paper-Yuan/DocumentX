<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chipCard"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/button_height_compact"
    android:layout_marginEnd="@dimen/spacing_small"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/surface_dark"
    app:cardCornerRadius="22dp"
    app:strokeColor="@color/border_dark"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:minHeight="@dimen/button_height_compact"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_medium">

        <ImageView
            android:id="@+id/ivChipIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_device_pc"
            app:tint="@color/secondary" />

        <TextView
            android:id="@+id/tvChipName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_small"
            android:text="Windows PC"
            android:textColor="@color/text_primary_dark"
            android:textSize="@dimen/text_size_caption"
            android:textStyle="bold" />

        <View
            android:id="@+id/vChipStatusDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="@dimen/spacing_xsmall"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/success" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
