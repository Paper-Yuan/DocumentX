<?xml version="1.0" encoding="utf-8"?>
<!--
  This device's own pairing code: the QR a peer scans plus the six digits a peer can type.
  The digits are monospace and large because they are read across a room, not at arm's length.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/tvMyPairHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="3dp"
        android:text="@string/my_pairing_hint"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="13sp" />

    <!-- QR plate: a scanner needs a light field behind the code, so this one stays white in
         every mode rather than following the theme. -->
    <ImageView
        android:id="@+id/ivMyPairQr"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_qr_plate"
        android:contentDescription="@string/my_pairing_title"
        android:padding="10dp"
        tools:src="@drawable/ic_qr_code" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.08"
        android:text="@string/my_pairing_code_label"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="@dimen/text_size_eyebrow" />

    <TextView
        android:id="@+id/tvMyPairPin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="monospace"
        android:letterSpacing="0.25"
        android:textColor="?attr/colorOnSurface"
        android:textSize="@dimen/pin_text_size"
        tools:text="481920" />

    <TextView
        android:id="@+id/tvMyPairAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="11sp"
        tools:text="192.168.10.7:8899" />

    <TextView
        android:id="@+id/tvMyPairWebNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingExtra="2dp"
        android:text="@string/my_pairing_web_note"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="11sp" />

</LinearLayout>
