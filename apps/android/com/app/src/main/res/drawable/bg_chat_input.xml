<?xml version="1.0" encoding="utf-8"?>
<!-- Message field: 8dp + hairline. The old 20dp radius made the input read as a floating pill
     inside a panel that is otherwise square. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/radius_medium" />
    <solid android:color="?attr/colorSurfaceVariant" />
    <stroke
        android:width="@dimen/hairline_width"
        android:color="?attr/colorOutline" />
</shape>
