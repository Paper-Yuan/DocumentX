<?xml version="1.0" encoding="utf-8"?>
<!-- A received file. The whole row is tappable (it opens the file) and the row itself says so -
     a file the user cannot find again is not a finished transfer. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardVaultFile"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/surface_dark"
    app:cardCornerRadius="@dimen/radius_large"
    app:cardElevation="0dp"
    app:strokeColor="@color/border_dark"
    app:strokeWidth="@dimen/hairline_width">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/ivFileIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_badge_rounded"
            android:backgroundTint="@color/surface_variant_dark"
            android:contentDescription="@string/vault_title"
            android:padding="8dp"
            android:src="@drawable/ic_download"
            app:tint="@color/ink" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvFileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:textColor="@color/text_primary_dark"
                android:textSize="14sp"
                android:textStyle="normal"
                tools:text="SafeDrop_File.zip" />

            <TextView
                android:id="@+id/tvFileMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:textColor="@color/text_muted_dark"
                android:textSize="11sp"
                tools:text="14.2 MB · 09-05 11:20" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenFile"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:text="@string/vault_open"
            android:textColor="@color/text_secondary_dark"
            android:textSize="12sp"
            app:cornerRadius="@dimen/radius_medium" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShareFile"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:contentDescription="@string/transfer_share_file"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:text="@string/vault_share"
            android:textColor="@color/text_secondary_dark"
            android:textSize="12sp"
            app:cornerRadius="@dimen/radius_medium" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
