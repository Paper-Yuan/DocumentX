<?xml version="1.0" encoding="utf-8"?>
<!--
  One line of the peer conversation: a text bubble or a transfer row. A finished transfer is not
  just a badge - it carries the actions that make the file findable again (open / share).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:orientation="vertical">

    <!-- 1. Text message bubble -->
    <LinearLayout
        android:id="@+id/layoutTextBubble"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone">

        <View
            android:id="@+id/spacerTextLeft"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:visibility="gone" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTextBubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/surface_dark"
            app:cardCornerRadius="@dimen/radius_large"
            app:cardElevation="0dp"
            app:strokeColor="@color/border_dark"
            app:strokeWidth="@dimen/hairline_width">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp">

                <TextView
                    android:id="@+id/tvMessageContent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:maxWidth="240dp"
                    android:textColor="@color/text_primary_dark"
                    android:textIsSelectable="true"
                    android:textSize="14sp"
                    tools:text="Hello SafeDrop!" />

                <TextView
                    android:id="@+id/tvMessageTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="4dp"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_muted_dark"
                    android:textSize="10sp"
                    tools:text="12:30" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <View
            android:id="@+id/spacerTextRight"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:visibility="gone" />

    </LinearLayout>

    <!-- 2. File transfer row -->
    <LinearLayout
        android:id="@+id/layoutFileCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="visible">

        <View
            android:id="@+id/spacerFileLeft"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:visibility="gone" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFileTransfer"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/surface_dark"
            app:cardCornerRadius="@dimen/radius_large"
            app:cardElevation="0dp"
            app:strokeColor="@color/border_dark"
            app:strokeWidth="@dimen/hairline_width">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivFileIcon"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_badge_rounded"
                        android:backgroundTint="@color/surface_variant_dark"
                        android:contentDescription="@string/transferring"
                        android:padding="8dp"
                        android:src="@drawable/ic_send"
                        app:tint="@color/ink" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvFileName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="middle"
                            android:fontFamily="sans-serif-medium"
                            android:singleLine="true"
                            android:textColor="@color/text_primary_dark"
                            android:textSize="13sp"
                            android:textStyle="normal"
                            tools:text="project_document.pdf" />

                        <TextView
                            android:id="@+id/tvFileSizeAndDirection"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="monospace"
                            android:textColor="@color/text_muted_dark"
                            android:textSize="11sp"
                            tools:text="14.2 MB · 发给这台电脑" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvFileStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_badge_rounded"
                        android:backgroundTint="@color/surface_variant_dark"
                        android:fontFamily="monospace"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:textColor="@color/text_secondary_dark"
                        android:textSize="10sp"
                        android:textStyle="normal"
                        tools:text="已完成" />

                </LinearLayout>

                <ProgressBar
                    android:id="@+id/pbFileTransfer"
                    style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginTop="10dp"
                    android:max="100"
                    android:progress="65" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvFileSpeed"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:textColor="@color/text_secondary_dark"
                        android:textSize="11sp"
                        tools:text="4.8 MB/s" />

                    <TextView
                        android:id="@+id/tvFileTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textColor="@color/text_muted_dark"
                        android:textSize="10sp"
                        tools:text="12:30" />

                </LinearLayout>

                <!-- Completion affordance: only shown once the file is on disk -->
                <LinearLayout
                    android:id="@+id/layoutFileActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFileOpenAction"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:paddingHorizontal="8dp"
                        android:text="@string/transfer_open_file"
                        android:textColor="@color/text_secondary_dark"
                        android:textSize="12sp"
                        app:cornerRadius="@dimen/radius_medium" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFileShareAction"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:contentDescription="@string/transfer_share_file"
                        android:paddingHorizontal="8dp"
                        android:text="@string/vault_share"
                        android:textColor="@color/text_secondary_dark"
                        android:textSize="12sp"
                        app:cornerRadius="@dimen/radius_medium" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <View
            android:id="@+id/spacerFileRight"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
