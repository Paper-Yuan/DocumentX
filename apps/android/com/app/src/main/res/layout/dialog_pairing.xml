<?xml version="1.0" encoding="utf-8"?>
<!--
  Pairing sheet. Everything a user has to do here is: read six digits off the other screen and
  put them in. So the digits are the only large thing on the sheet, the field auto-submits on the
  sixth one, and a pasted safedrop://pair link fills the rest in.

  Colours come from ?attr/ so the sheet follows whichever mode the activity was built with (the
  dialog is created against a ContextThemeWrapper for the current mode).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/tvPairSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="3dp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="13sp"
        tools:text="这台电脑 需要对方屏幕上显示的 6 位配对码。" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.08"
        android:text="@string/pairing_pin_hint"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="@dimen/text_size_eyebrow" />

    <!-- The pairing code: monospace so 6 digits are read as 6 digits, not as a blob -->
    <EditText
        android:id="@+id/etPairPin"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_field"
        android:fontFamily="monospace"
        android:gravity="center_vertical"
        android:hint="@string/pairing_pin_placeholder"
        android:importantForAutofill="no"
        android:inputType="number"
        android:letterSpacing="0.2"
        android:maxLength="6"
        android:maxLines="1"
        android:paddingHorizontal="14dp"
        android:textColor="?attr/colorOnSurface"
        android:textColorHint="?attr/colorOutline"
        android:textSize="@dimen/pin_text_size" />

    <!-- Inline state: never a toast, never a raw exception message -->
    <TextView
        android:id="@+id/tvPairError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:minLines="1"
        android:textColor="@color/state_failure_text"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="配对码不对或已过期"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tvPairPasteHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="2dp"
        android:text="@string/pairing_paste_hint"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="11sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/hairline_width"
        android:layout_marginTop="14dp"
        android:background="?attr/colorOutline" />

    <!-- Peer address and reachability, polled while the sheet is open -->
    <TextView
        android:id="@+id/tvPairPeerStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:drawablePadding="6dp"
        android:fontFamily="monospace"
        android:gravity="center_vertical"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="11sp"
        tools:text="192.168.10.42:8899 · 对方在线" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPairAdvanced"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginTop="2dp"
        android:paddingHorizontal="0dp"
        android:text="@string/pairing_advanced"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp"
        app:cornerRadius="@dimen/radius_medium" />

    <LinearLayout
        android:id="@+id/layoutPairAdvanced"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08"
            android:text="@string/pairing_host_label"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/text_size_eyebrow" />

        <EditText
            android:id="@+id/etPairHost"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_field"
            android:fontFamily="monospace"
            android:gravity="center_vertical"
            android:hint="@string/pairing_host_hint"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingHorizontal="14dp"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOutline"
            android:textSize="15sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvPairNotRemembered"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:lineSpacingExtra="2dp"
        android:text="@string/pairing_not_remembered"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="11sp" />

</LinearLayout>
