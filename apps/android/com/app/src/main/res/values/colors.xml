<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      SafeDrop shared design contract - identical to the desktop hub and the browser portal.

      Ink-first: neutral surfaces carry structure, chromatic colour means state only.
      There is no brand hue in this file. `primary` is the ink of the theme it belongs to, so a
      filled control reads as "text-shaped", and the four semantic hues below are the only
      saturated colours the UI is allowed to spend.

      Anything that lives only in code (dialogs built by hand, adapters painting rows) has to
      come back to this file for its colours; a hex written in Kotlin is a hex nobody compares
      against the desktop again.
    -->

    <!-- Ink: the single "brand" colour, and it is not a colour -->
    <color name="ink">#F2F4F5</color>
    <color name="ink_muted">#A7ADB3</color>
    <color name="ink_faint">#6E757C</color>
    <color name="ink_ink">#0B0D0F</color>
    <color name="ink_inverse">#0B0D0F</color>

    <!-- Semantic states. Same four hues on every theme and on both ends. -->
    <color name="state_ready">#2F8F5B</color>
    <color name="state_active">#2C6FB3</color>
    <color name="state_attention">#B8791C</color>
    <color name="state_failure">#B4453C</color>

    <!-- The same hues lifted for text sitting on a dark surface, where the base value drops
         below 4.5:1. Never used as a fill - fills take the base value. -->
    <color name="state_ready_text">#5CB37F</color>
    <color name="state_active_text">#6BA6DC</color>
    <color name="state_attention_text">#D6A24E</color>
    <color name="state_failure_text">#D9716A</color>

    <!-- Neutral greys for muted / offline, which is deliberately not a state -->
    <color name="neutral_muted">#6E757C</color>
    <color name="neutral_offline">#555B61</color>

    <!-- Legacy role names kept because ~90 XML references use them. They now resolve to ink. -->
    <color name="primary">@color/ink</color>
    <color name="primary_variant">@color/ink_muted</color>
    <color name="primary_light">@color/ink_muted</color>
    <color name="on_primary">@color/ink_inverse</color>
    <color name="secondary">@color/ink_muted</color>
    <color name="secondary_light">@color/ink_faint</color>
    <color name="on_secondary">@color/ink_inverse</color>
    <color name="success">@color/state_ready_text</color>
    <color name="success_light">@color/state_ready</color>
    <color name="warning">@color/state_attention_text</color>
    <color name="warning_light">@color/state_attention</color>
    <color name="error">@color/state_failure_text</color>
    <color name="error_light">@color/state_failure</color>

    <!-- Dark theme (default): #0B0D0F page, three raised surfaces, 1px hairlines instead of shadows -->
    <color name="background_dark">#0B0D0F</color>
    <color name="surface_dark">#101215</color>
    <color name="surface_variant_dark">#16191D</color>
    <color name="surface_elevated_dark">#1D2126</color>
    <color name="card_bg_dark">@color/surface_dark</color>
    <color name="border_dark">#24272B</color>
    <color name="border_hover_dark">#33383D</color>
    <color name="text_primary_dark">@color/ink</color>
    <color name="text_secondary_dark">@color/ink_muted</color>
    <color name="text_muted_dark">@color/ink_faint</color>

    <!-- Eye-care: warm paper, but the SAME ink and the SAME semantic hues as every other theme.
         Its old green brand is gone - a tinted surface is a lighting choice, not an identity. -->
    <color name="eyecare_background">#EDE7D8</color>
    <color name="eyecare_surface">#F3EDDF</color>
    <color name="eyecare_surface_variant">#E4DCC9</color>
    <color name="eyecare_card">#F7F2E6</color>
    <color name="eyecare_primary">@color/ink_on_paper</color>
    <color name="eyecare_primary_variant">#3A3F45</color>
    <color name="eyecare_primary_light">@color/ink_muted_on_paper</color>
    <color name="eyecare_accent">@color/ink_muted_on_paper</color>
    <color name="eyecare_border">#D6CDB6</color>
    <color name="eyecare_text_primary">@color/ink_on_paper</color>
    <color name="eyecare_text_secondary">#4C4A45</color>
    <color name="eyecare_text_muted">#726E64</color>

    <!-- Light theme: #F5F6F7 page on #FFFFFF sheets -->
    <color name="background_light">#F5F6F7</color>
    <color name="surface_light">#FFFFFF</color>
    <color name="surface_variant_light">#F7F8F9</color>
    <color name="surface_elevated_light">#FFFFFF</color>
    <color name="card_bg_light">@color/surface_light</color>
    <color name="border_light">#E2E4E6</color>
    <color name="border_hover_light">#CBCFD3</color>
    <color name="text_primary_light">#16181B</color>
    <color name="text_secondary_light">#5A6167</color>
    <color name="text_muted_light">#8A9198</color>

    <!-- Ink as used on paper / white, for themes that flip the dark theme's polarity -->
    <color name="ink_on_paper">#16181B</color>
    <color name="ink_muted_on_paper">#5A6167</color>
    <color name="ink_faint_on_paper">#8A9198</color>
    <color name="ink_inverse_on_paper">#FFFFFF</color>

    <!-- Radar canvas: the sweep is structure, so it is ink; only a found node gets a state hue -->
    <color name="radar_center">@color/ink_faint</color>
    <color name="radar_wave">#24272B</color>
    <color name="radar_device_node">@color/state_ready_text</color>
    <color name="radar_scan_beam">@color/ink_muted</color>

    <!-- Status roles -->
    <color name="online_status">@color/state_ready_text</color>
    <color name="offline_status">@color/neutral_offline</color>
    <color name="transferring_status">@color/state_active_text</color>
    <color name="completed_status">@color/state_ready_text</color>
    <color name="failed_status">@color/state_failure_text</color>
</resources>
