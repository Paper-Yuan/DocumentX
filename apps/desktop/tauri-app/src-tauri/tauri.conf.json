{
  "$schema": "https://schema.tauri.app/config/2.0",
  "productName": "SafeDrop",
  "version": "1.3.0",
  "identifier": "com.safedrop.desktop",
  "build": {
    "beforeDevCommand": "node ../../desktop_hub/server.js",
    "beforeBuildCommand": "",
    "devUrl": "http://localhost:8899",
    "frontendDist": "../../desktop_hub/public"
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "longDescription": "SafeDrop - Zero-config LAN file transfer with encrypted payloads (AES-256-GCM over X25519-derived session keys)",
    "shortDescription": "Encrypted LAN file transfer hub"
  },
  "app": {
    "windows": [
      {
        "title": "SafeDrop",
        "width": 1040,
        "height": 740,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http: ws:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; script-src 'self'"
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false
    }
  }
}
